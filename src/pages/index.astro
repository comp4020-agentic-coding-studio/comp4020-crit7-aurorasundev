---
import LibraryShell from "../layouts/LibraryShell.astro";
import { currentPlan, listLibraries, listRooms, planView } from "../lib/repo";
import { scenarioDates } from "../lib/seed";
import { addDays, DEMO_WINDOW_DAYS, demoWindow, fmtDate, fmtRange, fmtTime } from "../lib/time";

// A mock-up of today's ANU Library Bookings page (anu.libcal.com): the
// same structure and guidance, with the proposed Study Room Planner added
// where a student would meet it. No ANU logos or login.
const libraries = listLibraries();
const rooms = listRooms();
const hours = libraries.map((l) => {
  const r = rooms.filter((room) => room.libraryId === l.id);
  return { library: l, opens: Math.min(...r.map((x) => x.opensMin)), closes: Math.max(...r.map((x) => x.closesMin)) };
});
const win = demoWindow();
const windowDates = Array.from({ length: DEMO_WINDOW_DAYS }, (_, i) => addDays(win.first, i));
const scenarios = scenarioDates();
const times: number[] = [];
for (let t = 8 * 60; t <= 20 * 60; t += 30) times.push(t);
const user = Astro.locals.user;
const plan = currentPlan(user.id);
const view = plan ? planView(plan.id) : undefined;
const segments = view?.segments.length ?? 0;
---

<LibraryShell title="Book a group study room · Library Bookings (mock-up)">
  <div class="lib-cols">
    <div>
      <h1>Book a group study room</h1>
      <p class="lib-intro">
        The ANU Library offers a range of group study rooms for ANU students and staff to book during opening hours.
      </p>

      <section class="planner-card" aria-labelledby="planner-heading">
        <p class="planner-card__tag"><span>New</span> Proposed improvement</p>
        <h2 id="planner-heading">Plan a group session across all four libraries</h2>
        <p>
          Need more than one room, or more than your two hours? Compare every bookable room in Chifley, Hancock, Menzies and
          Law in one view, combine rooms into one plan, and invite a teammate to take the next segment.
        </p>
        <ul>
          <li>See room changes and real discussion time before you book</li>
          <li>Each person stays within their own 2-hour daily limit</li>
          <li>Confirm the whole plan in one step: every segment, or none</li>
        </ul>
        <div class="planner-card__actions">
          <a class="btn btn--primary" href="/search">Open Study Room Planner</a>
          <a class="btn planner-card__secondary" href="/my-plans">
            My plans{segments > 0 && ` (${segments} segment${segments === 1 ? "" : "s"} in progress)`}
          </a>
        </div>
        <p class="planner-card__note">Prototype bookings only: demo rooms and times, nothing is booked with ANU Library.</p>
      </section>

      <section aria-labelledby="libraries-heading" class="lib-section">
        <h2 id="libraries-heading" class="sr-only">Book by library</h2>
        <div class="lib-grid">
          {
            libraries.map((l) => (
              <div class="lib-panel">
                <h3>{l.name}</h3>
                <a class="lib-btn" href={`/search?library=${l.id}`}>
                  Book in {l.name}
                </a>
                <p class="lib-panel__note">Opens the planner filtered to {l.shortName}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="lib-section" aria-labelledby="making-heading">
        <h3 id="making-heading">Making a booking</h3>
        <ul>
          <li>Students can book a group study space for up to two hours a day.</li>
          <li>Bookings can be made up to two weeks in advance.</li>
          <li><em>Note: bookings are made in 24 hour time.</em></li>
          <li>Bookings must be made using an ANU email account.</li>
          <li>A confirmation email will be sent to this account on creation of a booking.</li>
          <li>If you are more than 15 minutes late your booking may be cancelled.</li>
          <li>Study room bookings are for ANU students and staff only.</li>
        </ul>
        <p class="lib-aside-note">
          In this prototype the two-hour limit and two-week window are enforced on demo data; no emails are sent and no ANU
          account is used.
        </p>
      </section>

      <section class="lib-section" aria-labelledby="rooms-heading">
        <h3 id="rooms-heading">Room information</h3>
        <ul>
          <li>There are a variety of room sizes and AV equipment offerings available.</li>
          <li>Details for each room, including capacity, are shown in the planner.</li>
          <li>
            All rooms are wheelchair accessible and have power outlets, with the exception of the Hancock Basement study room.
          </li>
          <li>Group study rooms are not recommended for students undertaking online exams.</li>
        </ul>
      </section>

      <section class="lib-section" aria-labelledby="rules-heading">
        <h3 id="rules-heading">Group study room rules</h3>
        <ul>
          <li>Personal belongings left unattended may be removed and taken to lost property.</li>
          <li>Hot food and uncovered drinks are not permitted.</li>
          <li>Users must follow the ANU Codes of Conduct.</li>
          <li>Please stay home if you are unwell.</li>
        </ul>
      </section>

      <section class="lib-section" aria-labelledby="hours-heading">
        <h3 id="hours-heading">Library opening hours</h3>
        <table class="lib-hours">
          <caption class="sr-only">Bookable hours used by this prototype's demo rooms</caption>
          <thead>
            <tr><th scope="col">Library</th><th scope="col">Bookable rooms (demo hours)</th></tr>
          </thead>
          <tbody>
            {
              hours.map((h) => (
                <tr>
                  <th scope="row">{h.library.name}</th>
                  <td>{fmtRange(h.opens, h.closes)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      <section class="lib-section" aria-labelledby="research-heading">
        <h2 id="research-heading" class="lib-h2">Book a Research Appointment</h2>
        <a class="lib-btn" href="https://anu.libcal.com/" rel="noopener">Book a Research Appointment on anu.libcal.com</a>
        <p class="lib-panel__note">Not part of this prototype. Opens the real ANU Library site.</p>
      </section>
    </div>

    <aside class="lib-side" aria-labelledby="quick-heading">
      <div class="lib-side__inner">
        <h2 id="quick-heading">Find a room in every library</h2>
        <form method="get" action="/search" class="quick-form">
          <div>
            <label for="q-date">Date</label>
            <select id="q-date" name="date">
              {windowDates.map((d) => <option value={d} selected={d === scenarios.crossRoom}>{fmtDate(d)}</option>)}
            </select>
          </div>
          <div class="quick-form__pair">
            <div>
              <label for="q-from">From</label>
              <select id="q-from" name="from">
                {times.slice(0, -1).map((t) => <option value={fmtTime(t)} selected={t === 13 * 60}>{fmtTime(t)}</option>)}
              </select>
            </div>
            <div>
              <label for="q-until">Until</label>
              <select id="q-until" name="until">
                {times.slice(1).map((t) => <option value={fmtTime(t)} selected={t === 15 * 60}>{fmtTime(t)}</option>)}
              </select>
            </div>
          </div>
          <div>
            <label for="q-people">People</label>
            <select id="q-people" name="people">
              {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <option value={n} selected={n === 4}>{n}</option>)}
            </select>
          </div>
          <button class="btn btn--primary btn--block">Search all libraries</button>
        </form>
        <p class="lib-panel__note">Searches Chifley, Hancock, Menzies and Law together in the Study Room Planner.</p>
      </div>
    </aside>
  </div>
</LibraryShell>
